
<link href="~/css/checkout.css" rel="stylesheet" />
<link href="~/css/cart.css" rel="stylesheet" />

<!-- ============ MAIN ============ -->
<main>
    <div class="container">

        <!-- Loading state -->
        <div id="checkoutLoading" class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-3 text-muted">Loading your order...</p>
        </div>

        <!-- Empty state (nothing to checkout) -->
        <div id="checkoutEmpty" class="cart-card text-center py-5 d-none">
            <i class="fas fa-cart-shopping fa-3x text-muted mb-3"></i>
            <h4>Your cart is empty</h4>
            <p class="text-muted">Add some items before checking out.</p>
            <a href="~/" class="nav-link-box home-box d-inline-block">Continue Shopping</a>
        </div>

        <!-- Checkout content -->
        <div id="checkoutContent" class="row g-4 d-none">

            <!-- Left column -->
            <div class="col-lg-8">

                <!-- Order items (read-only) -->
                <div class="cart-card mb-4">
                    <h5 class="fw-bold mb-3">Order Items</h5>
                    <div id="checkoutItemsList"><!-- item rows injected here --></div>
                </div>

                <!-- Delivery information -->
                <div class="cart-card">
                    <h5 class="fw-bold mb-3">Delivery Information</h5>

                    <form id="deliveryForm" novalidate>
                        <div class="row g-3">
                            <div class="col-6">
                                <label for="name" class="form-label">Name</label>
                                <input type="text" class="form-control" id="name" name="name" required />
                                <div class="invalid-feedback">Please enter your name.</div>
                            </div>
                            <div class="col-md-6">
                                <label for="phone" class="form-label">Phone Number</label>
                                <input type="tel" class="form-control" id="phone" name="phone"
                                       pattern="^[0-9+\-\s]{8,15}$" required>
                                <div class="invalid-feedback">Please enter a valid phone number.</div>
                            </div>

                            <div class="col-md-6">
                                <label for="city" class="form-label">City</label>
                                <input type="text" class="form-control" id="city" name="city" required>
                                <div class="invalid-feedback">Please enter your city.</div>
                            </div>
                            <div class="col-6">
                                <label for="address" class="form-label">Address</label>
                                <textarea class="form-control" id="address" name="address" rows="2" required></textarea>
                                <div class="invalid-feedback">Please enter your delivery address.</div>
                            </div>

                            <div class="col-12">
                                <label for="notes" class="form-label">Additional Notes <span class="text-muted fw-normal">(optional)</span></label>
                                <textarea class="form-control" id="notes" name="notes" rows="2"
                                          placeholder="e.g. landmark, preferred delivery time..."></textarea>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Summary -->
            <div class="col-lg-4">
                <div class="cart-card summary-card">
                    <h5 class="fw-bold mb-3">Order Summary</h5>

                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Subtotal</span>
                        <span id="sumSubtotal">$0.00</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Shipping</span>
                        <span id="sumShipping">Free</span>
                    </div>
                    <hr>
                    <div class="d-flex justify-content-between mb-4">
                        <span class="fw-bold">Total</span>
                        <span id="sumTotal" class="fw-bold fs-5">$0.00</span>
                    </div>

                    <!-- Payment method -->
                    <div class="mb-4">
                        <h6 class="fw-bold mb-2">Payment Method</h6>
                        <div id="paymentMethodGroup" class="payment-method-group">

                            <label class="payment-method-option">
                                <input type="radio" name="paymentMethod" value="@((int)ePaymentMethod.CashOnDelivery)" checked>
                                <span class="payment-method-card">
                                    <i class="fas fa-money-bill-wave"></i>
                                    <span>Cash on Delivery</span>
                                </span>
                            </label>

                            <label class="payment-method-option">
                                <input type="radio" name="paymentMethod" value="@((int)ePaymentMethod.CreditCard)">
                                <span class="payment-method-card">
                                    <i class="fas fa-credit-card"></i>
                                    <span>Credit Card</span>
                                </span>
                            </label>

                            <label class="payment-method-option">
                                <input type="radio" name="paymentMethod" value="@((int)ePaymentMethod.DebitCard)">
                                <span class="payment-method-card">
                                    <i class="far fa-credit-card"></i>
                                    <span>Debit Card</span>
                                </span>
                            </label>

                            <label class="payment-method-option">
                                <input type="radio" name="paymentMethod" value="@((int)ePaymentMethod.ApplePay)">
                                <span class="payment-method-card">
                                    <i class="fab fa-apple-pay"></i>
                                    <span>Apple Pay</span>
                                </span>
                            </label>

                        </div>
                        <div id="paymentMethodError" class="invalid-feedback d-block d-none">
                            Please select a payment method.
                        </div>
                    </div>

                    <button id="payBtn" type="button" class="btn btn-checkout w-100">
                        Proceed to Payment <i class="fas fa-arrow-right ms-1"></i>
                    </button>
                    <a href="~/Customer/Cart" class="btn btn-outline-secondary w-100 mt-2">Back to Cart</a>
                </div>
            </div>
        </div>

        <!-- Error state -->
        <div id="checkoutError" class="alert alert-danger d-none mt-4" role="alert"></div>

    </div>
</main>

<!-- ============ ITEM ROW TEMPLATE (read-only) ============ -->
<template id="checkoutItemTemplate">
    <div class="cart-item checkout-item" data-product-id="">
        <div class="cart-item-info">
            <div class="cart-item-name"></div>
            <div class="cart-item-price text-muted"></div>
        </div>
        <div class="checkout-item-qty text-muted">x <span class="qty-value"></span></div>
        <div class="cart-item-subtotal fw-bold"></div>
    </div>
</template>

@section Scripts {
    <script src="~/js/modules/customer/checkout.js"></script>
}
