

<link href="~/css/cart.css" rel="stylesheet" />

<!-- ============ MAIN ============ -->
<main>
    <div class="container">

        <!-- Loading state -->
        <div id="cartLoading" class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-3 text-muted">Loading your cart...</p>
        </div>

        <!-- Empty state -->
        <div id="cartEmpty" class="cart-card text-center py-5 d-none">
            <i class="fas fa-cart-arrow-down fa-3x text-muted mb-3"></i>
            <h4>Your cart is empty</h4>
            <p class="text-muted">Looks like you haven't added anything yet.</p>
            <a href="~/" class="nav-link-box home-box d-inline-block">Continue Shopping</a>
        </div>

        <!-- Cart content -->
        <div id="cartContent" class="row g-4 d-none">

            <!-- Items -->
            <div class="col-lg-8">
                <div class="cart-card">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="mb-0 fw-bold">Items</h5>
                        <button id="clearCartBtn" class="btn btn-sm btn-link text-danger text-decoration-none">
                            <i class="fas fa-trash"></i> Clear cart
                        </button>
                    </div>

                    <div id="cartItemsList"><!-- item rows injected here --></div>
                </div>
            </div>

            <!-- Summary -->
            <div class="col-lg-4">
                <div class="cart-card summary-card">
                    <h5 class="fw-bold mb-3">Order Summary</h5>

                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Subtotal</span>
                        <span id="sumSubtotal">$0.00</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Shipping</span>
                        <span id="sumShipping">Free</span>
                    </div>
                    <hr>
                    <div class="d-flex justify-content-between mb-4">
                        <span class="fw-bold">Total</span>
                        <span id="sumTotal" class="fw-bold fs-5">$0.00</span>
                    </div>

                    <button id="checkoutBtn" class="btn btn-checkout w-100">
                        Proceed to Checkout <i class="fas fa-arrow-right ms-1"></i>
                    </button>
                    <a href="~/" class="btn btn-outline-secondary w-100 mt-2">Continue Shopping</a>
                </div>
            </div>
        </div>

        <!-- Error state -->
        <div id="cartError" class="alert alert-danger d-none mt-4" role="alert"></div>

    </div>
</main>

<!-- ============ ITEM ROW TEMPLATE ============ -->
<template id="cartItemTemplate">
    <div class="cart-item" data-product-id="">
        <div class="cart-item-info">
            <div class="cart-item-name"></div>
            <div class="cart-item-price text-muted"></div>
        </div>

        <div class="cart-item-qty">
            <button class="qty-btn qty-decrease" type="button" aria-label="Decrease quantity">-</button>
            <input type="number" class="qty-input" min="1" value="1">
            <button class="qty-btn qty-increase" type="button" aria-label="Increase quantity">+</button>
        </div>

        <div class="cart-item-subtotal fw-bold"></div>

        <button class="remove-btn" type="button" aria-label="Remove item">
            <i class="fas fa-trash"></i>
        </button>
    </div>
</template>

@section Scripts {
    <script src="~/js/modules/customer/cart.js"></script>
}

 
