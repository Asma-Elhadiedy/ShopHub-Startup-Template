@model ProductDetailsVM

@{
    ViewData["Title"] = Model.Name;
}

<div class="container py-5">
    <div class="row g-4 align-items-start">
        <div class="col-lg-5">
            <div class="card shadow-sm">
                <div class="card-body p-3">
                    @if (!string.IsNullOrWhiteSpace(Model.ImagePath))
                    {
                        <img src="@Model.ImagePath" alt="@Model.Name" class="img-fluid rounded" />
                    }
                    else
                    {
                        <div class="bg-light rounded d-flex align-items-center justify-content-center" style="min-height: 280px;">
                            <i class="fas fa-image fa-3x text-muted" aria-hidden="true"></i>
                        </div>
                    }
                </div>
            </div>
        </div>
        <div class="col-lg-7">
            <p class="text-muted mb-2">@Model.CategoryName</p>
            <h1 class="mb-3">@Model.Name</h1>
            <div class="d-flex flex-wrap align-items-center gap-3 mb-3">
                <span class="h3 text-primary mb-0">$@Model.Price.ToString("N2")</span>
                <span aria-label="@Model.AverageRating out of 5 stars">
                    @for (var star = 1; star <= 5; star++)
                    {
                        <i class="@(star <= Math.Round(Model.AverageRating) ? "fas" : "far") fa-star text-warning"></i>
                    }
                    <strong class="ml-1">@Model.AverageRating.ToString("0.0")</strong>
                    <span class="text-muted">(@Model.ReviewCount review@(Model.ReviewCount == 1 ? "" : "s"))</span>
                </span>
            </div>
            <p class="lead">@Model.Description</p>
            <button type="button" class="btn btn-primary" onclick="addToCart(@Model.Id)">
                <i class="fas fa-cart-plus mr-2"></i>Add to Cart
            </button>
        </div>
    </div>

    <section class="mt-5 pt-4 border-top" id="reviews">
        <div class="d-flex flex-wrap justify-content-between align-items-end mb-4">
            <div>
                <h2>Customer Reviews</h2>
                <p class="text-muted mb-0">Share your experience with this product.</p>
            </div>
            <span class="text-muted">@Model.ReviewCount review@(Model.ReviewCount == 1 ? "" : "s")</span>
        </div>

        @if (User.Identity?.IsAuthenticated == true && Model.CurrentUserReview is null)
        {
            <partial name="_AddReview" model="Model.ProductReviewFormVM" />
        }
        else if (User.Identity?.IsAuthenticated == true)
        {
            <partial name="_EditDeleteReview" model="Model.ProductReviewFormVM" />
        }
        else
        {
            <div class="alert alert-info">
                <a asp-area="" asp-controller="Account" asp-action="Login" asp-route-redirectUrl="/Customer/Product/Details/@Model.Id">Sign in</a>
                to share your rating and review.
            </div>
        }

        @if (Model.Reviews.Count == 0)
        {
            <div class="alert alert-light border">No reviews yet. Be the first to share your experience.</div>
        }
        else
        {
            <div class="row">
                @foreach (var review in Model.Reviews)
                {
                    <div class="col-12 mb-3">
                        <article class="card shadow-sm">
                            <div class="card-body">
                                <div class="d-flex flex-wrap justify-content-between mb-2">
                                    <strong>@review.CustomerName</strong>
                                    <time class="text-muted" datetime="@review.CreatedAt.ToString("O")">@review.CreatedAt.ToLocalTime().ToString("MMM d, yyyy")</time>
                                </div>
                                <div class="mb-2" aria-label="@review.Rating out of 5 stars">
                                    @for (var star = 1; star <= 5; star++)
                                    {
                                        <i class="@(star <= review.Rating ? "fas" : "far") fa-star text-warning"></i>
                                    }
                                </div>
                                <p class="mb-0">@review.Comment</p>
                            </div>
                        </article>
                    </div>
                }
            </div>
        }
    </section>
</div>

@section Scripts {
    <script src="~/js/modules/Customer/productdetails.js"></script>
}
