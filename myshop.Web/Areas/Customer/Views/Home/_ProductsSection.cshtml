@model PagingDTO<ShoppingProductVM>

@if (Model.Data.Any())
{
    @foreach (var product in Model.Data)
    {

        <!-- ============ PRODUCT CARD (repeat per product) ============ -->
        <div class="col-6 col-md-4 col-lg-3">
            <div class="product-card" data-product-id="@product.Id">
                <div class="product-img-wrap">
                    <img src="@product.ImagePath" alt="@product.Name" class="product-img">
                </div>
                <div class="product-body">
                    <h3 class="product-name">
                        <a asp-area="Customer" asp-controller="Product" asp-action="Details" asp-route-id="@product.Id">@product.Name</a>
                    </h3>
                    <div class="product-price">$@product.Price</div>
                    <button type="button" class="btn-add-cart" onclick="addToCart(@product.Id)">
                        <i class="fas fa-cart-plus"></i> Add to Cart
                    </button>
                </div>
            </div>
        </div>
        <!-- ============ END PRODUCT CARD ============ -->
    }
}
else
{
    <div class="col-12">
        <p class="text-center">No products available.</p>
    </div>
}