@{
    ViewBag.Title = "Setting Management";
    ViewBag.CardTitle = "Admin Settings";
    Layout = "~/Areas/Admin/Views/Shared/_Dashboard.cshtml";
}


<div class="custom-card">

    <div class="custom-card-title">
        <i class="fas fa-cog me-2"></i>
        @ViewBag.CardTitle
    </div>

    <div class="top-btn">
        <button class="btn btn-primary" onclick="restoreDeletedProducts()">
            <i class="fas fa-edit me-1"></i>
            Restore Deleted Products
        </button>
    </div>

</div>


@section Scripts {
    <script src="~/js/modules/admin/settings.js"></script>
}