@{
    ViewBag.Title = "Users Management";
    ViewBag.CardTitle = "View Users";
    Layout = "~/Areas/Admin/Views/Shared/_Dashboard.cshtml";
}

<div class="custom-card">

    <div class="custom-card-title">
        <i class="fas fa-box-open me-2"></i>
        @ViewBag.CardTitle
    </div>

    <div class="top-btn">
        <a asp-area="Admin"
           asp-controller="User"
           asp-action="Create"
           class="btn btn-primary">
            <i class="fas fa-plus-circle me-1"></i>
            Create User
        </a>
    </div>

    <table id="mytable" class="display table-hover" width="100%">
    </table>

</div>

@section Scripts {
    <script src="~/js/modules/admin/users.js"></script>
}


